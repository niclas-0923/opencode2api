{
  "listen": "127.0.0.1:8080",
  "server_keys": ["change-this-local-key"],
  // Keyless free lane. Traffic may be rate limited upstream; add proxies or WARP.
  "anonymous": true,
  "warp": {
    "enabled": false,
    "pool_size": 2,
    "stack": "ipv6",
    "source_ipv6": ""
  },
  "proxies": ["direct"],
  "proxyfile": "",
  "upstream": {
    "anonymous": "https://opencode.ai/inference",
    "prompt_environment": {}
  },
  "retry": {
    "max_attempts": 3,
    "timeout_seconds": 300
  },
  "models": {
    "refresh_seconds": 300,
    "protocols": {},
    "free_only": true,
    "active_probes": false
  },
  "performance": {
    "max_idle_conns": 2048,
    "max_idle_conns_per_host": 256,
    "max_conns_per_host": 0,
    "idle_conn_timeout_seconds": 120,
    "connect_timeout_seconds": 5,
    "failure_cooldown_seconds": 15,
    "attempt_timeout_seconds": 0,
    "first_event_timeout_seconds": 0,
    "max_anonymous_exits": 8,
    "free_tier_block_seconds": 900,
    "max_inflight": 32,
    "max_request_bytes": 4194304,
    "max_attachment_bytes": 16777216
  },
  "logging": {
    "level": "info",
    "ring_size": 2000,
    "dump_request_bodies": false
  },
  "webui": {
    "enabled": true,
    "username": "admin",
    "password": "change-this-admin-password",
    "session_ttl_minutes": 720,
    // Peer addresses (IP or CIDR) of reverse proxies allowed to speak for the
    // real client: the rightmost X-Forwarded-For entry becomes the client
    // identity behind rate limits, and X-Forwarded-Proto is honored. Set this
    // to the address your proxy connects from (at most 16 entries); remove it
    // for direct access.
    "trusted_proxies": ["127.0.0.1"]
  },
  "reasoning": {
    "effort": "high",
    "effort_by_model": {}
  },
  "rotation": {
    "sota": {
      "alias": "sota",
      "order": ["deepseek-v4.1-flash", "glm-5.3", "grok-4.6", "kimi-k3", "qwen3.8-max"]
    },
    "sweet": {
      "alias": "sweet",
      "order": []
    },
    "first_output_seconds": 30
  }
}
